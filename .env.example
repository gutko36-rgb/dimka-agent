# Telegram
# Shared bot identity (safe defaults preserve the existing Dimka bot).
BOT_ID=dimka
BOT_ROLE=personal_assistant
BOT_DISPLAY_NAME=Димка
# Optional human-visible notification group; not a bot-to-bot transport.
BOT_COORDINATION_CHAT_ID=-1004326591308
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Groq
GROQ_API_KEY=
GROQ_MODEL=

# Main Telegram bot: server-side service_role/secret key only.
# Never use or commit this key in a specialized worker.
SUPABASE_URL=
SUPABASE_KEY=
# Trusted admin provisioning/smoke-test machines only; never put on a worker host.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated worker only: public key + its own Supabase Auth credentials.
# Provision the Auth user with scripts/provision_bot_identity.py on a trusted admin machine.
SUPABASE_ANON_KEY=
BOT_AUTH_EMAIL=
BOT_AUTH_PASSWORD=
BOT_WORKER_BATCH_SIZE=10

# Optional integrations
TODOIST_API_TOKEN=

# Route read-only natural-language finance questions through the isolated worker.
# Enable only when the finance worker is running with its private .env.worker.
FINANCE_QUEUE_ENABLED=false

# Route read-only project status queries through a separately provisioned projects worker.
# Enable only after creating its Auth identity and starting its private worker process.
PROJECTS_QUEUE_ENABLED=false

# The bot reads per-user timezone from Supabase profiles.
# Initial profile defaults are configured in the database.

# Debt and budget Telegram commands stay disabled until the SQL proposal is tested and applied.
FINANCE_DEBT_ENABLED=false

# Goals and habits commands are opt-in; enable only after the lifestyle migration is deployed.
LIFESTYLE_AGENT_ENABLED=false

# Optional Groq speech-to-text; incurs usage charges, disabled by default.
VOICE_TRANSCRIPTION_ENABLED=false
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional OCR for project images; OCR text is displayed in Telegram, not stored as searchable text.
VISION_OCR_ENABLED=false
GROQ_VISION_MODEL=qwen/qwen3.8-27b
